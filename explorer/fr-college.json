                "blocs": [
                  {
                    "type": "retenir",
                    "titre": "À retenir",
                    "texte": "Soustraire un nombre, c’est ajouter son opposé : $a-b=a+(-b)$. On transforme d’abord la soustraction en addition, puis on applique la règle de l’addition."
                  },
                  {
                    "type": "exemple",
                    "titre": "Exemple",
                    "enonce": "Calculer $(+4)-(-9)$.",
                    "etapes": [
                      "On ajoute l’opposé de $-9$, c’est-à-dire $+9$ : $(+4)-(-9)=(+4)+(+9)$.",
                      "Les deux nombres sont positifs : $4+9=13$.",
                      "$(+4)-(-9)=+13$."
                    ]
                  },
                  {
                    "type": "question",
                    "enonce": "Combien vaut $(-3)-(+8)$ ?",
                    "choix": [
                      "$+5$",
                      "$-5$",
                      "$-11$"
                    ],
                    "bonne": 2,
                    "explication": "On ajoute l’opposé de $+8$ : $(-3)-(+8)=(-3)+(-8)$. Les deux nombres sont négatifs : $3+8=11$, donc le résultat est $-11$."
                  }
                ]
              },
