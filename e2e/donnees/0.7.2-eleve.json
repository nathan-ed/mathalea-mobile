    "paliers": [
     {
      "titre": "Simplifier une fraction",
      "nb": 1,
      "fiche": {
       "titre": "Simplifier une fraction",
       "avant": true,
       "blocs": [
        {
         "type": "retenir",
         "titre": "À retenir",
         "texte": "On simplifie une fraction en divisant son numérateur et son dénominateur par un même nombre, un diviseur commun aux deux. La fraction est irréductible quand leur seul diviseur commun est $1$."
        },
        {
         "type": "exemple",
         "titre": "Exemple",
         "enonce": "Simplifier $\\dfrac{18}{24}$.",
         "etapes": [
          "$18$ et $24$ sont tous les deux divisibles par $6$.",
          "$\\dfrac{18}{24}=\\dfrac{18\\div6}{24\\div6}=\\dfrac{3}{4}$.",
          "$3$ et $4$ n’ont que $1$ comme diviseur commun : $\\dfrac{3}{4}$ est irréductible."
         ]
        },
        {
         "type": "question",
         "enonce": "Quelle fraction est égale à $\\dfrac{15}{35}$ ?",
         "choix": [
          "$\\dfrac{1}{2}$",
          "$\\dfrac{3}{7}$",
          "$\\dfrac{5}{7}$"
         ],
         "bonne": 1,
         "explication": "On divise $15$ et $35$ par $5$ : $\\dfrac{15\\div5}{35\\div5}=\\dfrac{3}{7}$."
        }
       ]
      }
     },
     {
      "titre": "Additionner et soustraire des fractions",
      "nb": 1,
      "fiche": {
       "titre": "Additionner et soustraire des fractions",
       "avant": true,
       "blocs": [
        {
         "type": "retenir",
         "titre": "À retenir",
         "texte": "Pour additionner ou soustraire deux fractions, on les écrit d’abord avec le même dénominateur. On additionne (ou on soustrait) ensuite les numérateurs et on garde ce dénominateur."
        },
        {
         "type": "exemple",
         "titre": "Exemple",
         "enonce": "Calculer $\\dfrac{2}{3}+\\dfrac{1}{6}$.",
         "etapes": [
          "$6$ est un multiple de $3$ : $\\dfrac{2}{3}=\\dfrac{2\\times2}{3\\times2}=\\dfrac{4}{6}$.",
          "$\\dfrac{4}{6}+\\dfrac{1}{6}=\\dfrac{5}{6}$."
         ]
        },
        {
         "type": "question",
         "enonce": "Combien vaut $\\dfrac{1}{4}+\\dfrac{3}{8}$ ?",
         "choix": [
          "$\\dfrac{4}{12}$",
          "$\\dfrac{4}{8}$",
          "$\\dfrac{5}{8}$"
         ],
         "bonne": 2,
         "explication": "$\\dfrac{1}{4}=\\dfrac{2}{8}$, donc $\\dfrac{2}{8}+\\dfrac{3}{8}=\\dfrac{5}{8}$. On n’additionne jamais les dénominateurs."
        }
       ]
      },
      "acces": "seuil",
      "seuil": 80
     },
     {
      "titre": "Multiplier et diviser des fractions",
      "nb": 1,
      "fiche": {
       "titre": "Multiplier et diviser des fractions",
       "avant": true,
       "blocs": [
        {
         "type": "retenir",
         "titre": "À retenir",
         "texte": "Pour multiplier deux fractions, on multiplie les numérateurs entre eux et les dénominateurs entre eux. Diviser par une fraction, c’est multiplier par son inverse. Une division peut aussi s’écrire avec une grande barre de fraction : $\\dfrac{\\frac{2}{3}}{5}=\\dfrac{2}{3}\\div5=\\dfrac{2}{3}\\times\\dfrac{1}{5}$."
        },
        {
         "type": "exemple",
         "titre": "Exemple",
         "enonce": "Calculer $\\dfrac{3}{5}\\div\\dfrac{9}{10}$.",
         "etapes": [
          "L’inverse de $\\dfrac{9}{10}$ est $\\dfrac{10}{9}$ : $\\dfrac{3}{5}\\div\\dfrac{9}{10}=\\dfrac{3}{5}\\times\\dfrac{10}{9}$.",
          "$=\\dfrac{3\\times10}{5\\times9}=\\dfrac{30}{45}$.",
          "On simplifie par $15$ : $\\dfrac{30}{45}=\\dfrac{2}{3}$."
         ]
        },
        {
         "type": "question",
         "enonce": "Combien vaut $\\dfrac{2}{7}\\times\\dfrac{3}{4}$ ?",
         "choix": [
          "$\\dfrac{3}{14}$",
          "$\\dfrac{5}{11}$",
          "$\\dfrac{6}{11}$"
         ],
         "bonne": 0,
         "explication": "$\\dfrac{2\\times3}{7\\times4}=\\dfrac{6}{28}$, puis on simplifie par $2$ : $\\dfrac{3}{14}$."
        }
       ]
      },
      "acces": "seuil",
      "seuil": 80
     }
    ]
